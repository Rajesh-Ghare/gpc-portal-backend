NODE_ENV=development

PORT=5000

# API
API_BASE_PATH=/api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=competitive_exam
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
# With DB_SSL=true the database certificate is verified. Providers using a
# public CA need nothing more; otherwise point this at the CA bundle your
# provider publishes (free download, e.g. AWS RDS global-bundle.pem).
DB_SSL_CA_PATH=
# Temporary escape hatch only: encrypt but skip verification (MITM-able).
# Logs a warning on startup. Remove once DB_SSL_CA_PATH is set.
DB_SSL_ALLOW_UNVERIFIED=false

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_TOKEN_SECRET=

# Providers: `mock` is for local dev/tests only. With NODE_ENV=production the
# server refuses to start if OTP_PROVIDER or PAYMENT_PROVIDER is mock/unset.

# OTP
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Rate limits (sliding 1-hour window; 0 disables — never in production).
# See docs/AUTHENTICATION.md "Rate Limiting".
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_NUMBER_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=50
OTP_MAX_VERIFY_ATTEMPTS_PER_NUMBER_PER_HOUR=10

# Proxy: leave unset when clients connect directly. Behind a load balancer
# set the hop count (e.g. 1) or proxy addresses (e.g. loopback, 10.0.0.0/8)
# so req.ip is the real client. `true` is refused (spoofable).
TRUST_PROXY=

# Payments
PAYMENT_PROVIDER=mock

# AI
AI_PROVIDER=mock

# CORS
CORS_ORIGIN=http://localhost:5173
